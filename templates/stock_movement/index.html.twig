{% extends 'base.html.twig' %}

{% block title %}Mouvements de stock - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-7xl px-6 py-10">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <h1 class="text-3xl font-bold text-gray-900">
                Mouvements de stock
            </h1>

            <p class="mt-1 text-gray-600">
                Historique des entrées et sorties de stock.
            </p>
        </div>
        <form method="get" class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">

            <div class="grid gap-4 md:grid-cols-3">

                <div>
                    <label
                        for="search"
                        class="mb-2 block text-sm font-medium text-gray-700"
                    >
                        Rechercher un produit
                    </label>

                    <input
                        type="text"
                        id="search"
                        name="search"
                        value="{{ search|default('') }}"
                        placeholder="Ex : Clavier"
                        class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    >
                </div>

                <div>
                    <label
                        for="type"
                        class="mb-2 block text-sm font-medium text-gray-700"
                    >
                        Type de mouvement
                    </label>

                    <select
                        id="type"
                        name="type"
                        class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                    >
                        <option value="">Tous les mouvements</option>

                        <option
                            value="Entrée"
                            {% if type|default('') == 'Entrée' %}selected{% endif %}
                        >
                            Entrée
                        </option>

                        <option
                            value="Sortie"
                            {% if type|default('') == 'Sortie' %}selected{% endif %}
                        >
                            Sortie
                        </option>
                    </select>
                </div>

                <div class="flex items-end gap-2">

                    <button
                        type="submit"
                        class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
                    >
                        Rechercher
                    </button>

                    <a
                        href="{{ path('app_stock_movement_index') }}"
                        class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
                    >
                        Réinitialiser
                    </a>

                </div>

            </div>

        </form>
        <a
            href="{{ path('app_stock_movement_new') }}"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
        >
            + Nouveau mouvement
        </a>

    </div>

    {% if stock_movements|length > 0 %}

        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">

            <table class="w-full">

                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Type
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Produit
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Quantité
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Motif
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Date
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                {% for stock_movement in stock_movements %}

                    <tr class="border-t border-gray-200 hover:bg-gray-50">

                        <td class="px-5 py-4">

                            {% if stock_movement.type == 'Entrée' %}

                                <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                                    Entrée
                                </span>

                            {% else %}

                                <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                    Sortie
                                </span>

                            {% endif %}

                        </td>

                        <td class="px-5 py-4 font-medium text-gray-900">
                            {{ stock_movement.product }}
                        </td>

                        <td class="px-5 py-4 text-gray-600">
                            {{ stock_movement.quantity }}
                        </td>

                        <td class="px-5 py-4 text-gray-600">
                            {{ stock_movement.reason ?: 'Aucun motif' }}
                        </td>

                        <td class="px-5 py-4 text-gray-600">
                            {{ stock_movement.createdAt|date('d/m/Y H:i') }}
                        </td>

                        <td class="px-5 py-4">

                            <div class="flex flex-wrap gap-2">

                                <a
                                    href="{{ path('app_stock_movement_show', {'id': stock_movement.id}) }}"
                                    class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
                                >
                                    Voir
                                </a>

                                <a
                                    href="{{ path('app_stock_movement_edit', {'id': stock_movement.id}) }}"
                                    class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                                >
                                    Modifier
                                </a>

                            </div>

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    {% else %}

        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm">

            <p class="text-gray-600">
                Aucun mouvement de stock n'a encore été enregistré.
            </p>

            <a
                href="{{ path('app_stock_movement_new') }}"
                class="mt-4 inline-block rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
            >
                Enregistrer le premier mouvement
            </a>

        </div>

    {% endif %}

</div>

{% endblock %}
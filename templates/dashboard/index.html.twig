{% extends 'base.html.twig' %}

{% block title %}Dashboard - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-7xl px-6 py-10">

    <!-- En-tête -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            Tableau de bord
        </h1>

        <p class="mt-2 text-gray-600">
            Vue d'ensemble de votre gestion de stock.
        </p>
    </div>


    <!-- Cartes statistiques -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">

        <!-- Produits -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">
                Produits
            </p>

            <p class="mt-2 text-3xl font-bold text-gray-900">
                {{ totalProducts }}
            </p>
        </div>


        <!-- Catégories -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">
                Catégories
            </p>

            <p class="mt-2 text-3xl font-bold text-gray-900">
                {{ totalCategories }}
            </p>
        </div>


        <!-- Mouvements -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">
                Mouvements de stock
            </p>

            <p class="mt-2 text-3xl font-bold text-gray-900">
                {{ totalMovements }}
            </p>
        </div>


        <!-- Stock faible -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">
                Stock faible
            </p>

            <p class="mt-2 text-3xl font-bold text-gray-900">
                {{ lowStockProducts }}
            </p>

            <p class="mt-1 text-sm text-gray-500">
                Produits avec 5 unités ou moins
            </p>
        </div>


        <!-- Valeur du stock -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-gray-500">
                Valeur du stock
            </p>

            <p class="mt-2 text-3xl font-bold text-gray-900">
                {{ totalStockValue|number_format(0, ',', ' ') }} Ar
            </p>

            <p class="mt-1 text-sm text-gray-500">
                Valeur totale du stock actuel
            </p>
        </div>

    </div>


    <!-- Actions rapides -->
    <div class="mt-10">

        <h2 class="text-xl font-bold text-gray-900">
            Actions rapides
        </h2>

        <p class="mt-1 text-sm text-gray-600">
            Accédez rapidement aux principales fonctionnalités de StockPro.
        </p>


        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">

            <!-- Ajouter un produit -->
            <a
                href="{{ path('app_product_new') }}"
                class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
                <p class="font-semibold text-gray-900">
                    Ajouter un produit
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Créer un nouveau produit
                </p>
            </a>


            <!-- Gérer les catégories -->
            <a
                href="{{ path('app_category_index') }}"
                class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
                <p class="font-semibold text-gray-900">
                    Gérer les catégories
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Consulter les catégories
                </p>
            </a>


            <!-- Nouveau mouvement -->
            <a
                href="{{ path('app_stock_movement_new') }}"
                class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
                <p class="font-semibold text-gray-900">
                    Nouveau mouvement
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Enregistrer une entrée ou une sortie
                </p>
            </a>


            <!-- Voir les mouvements -->
            <a
                href="{{ path('app_stock_movement_index') }}"
                class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
                <p class="font-semibold text-gray-900">
                    Voir les mouvements
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Consulter l'historique des mouvements
                </p>
            </a>

        </div>

    </div>


    <!-- Produits en stock faible -->
    <div class="mt-10">

        <div class="mb-6">
            <h2 class="text-xl font-bold text-gray-900">
                Produits en stock faible
            </h2>

            <p class="mt-1 text-sm text-gray-600">
                Produits dont la quantité disponible est de 5 unités ou moins.
            </p>
        </div>


        {% if lowStockProductList is not empty %}

            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

                <div class="overflow-x-auto">

                    <table class="w-full text-left text-sm">

                        <thead class="border-b border-gray-200 bg-gray-50">

                            <tr>

                                <th class="px-5 py-4 font-semibold text-gray-700">
                                    Produit
                                </th>

                                <th class="px-5 py-4 font-semibold text-gray-700">
                                    Catégorie
                                </th>

                                <th class="px-5 py-4 font-semibold text-gray-700">
                                    Quantité
                                </th>

                                <th class="px-5 py-4 text-right font-semibold text-gray-700">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-gray-100">

                            {% for product in lowStockProductList %}

                                <tr class="hover:bg-gray-50">

                                    <td class="px-5 py-4 font-medium text-gray-900">
                                        {{ product.name }}
                                    </td>

                                    <td class="px-5 py-4 text-gray-600">
                                        {{ product.category }}
                                    </td>

                                    <td class="px-5 py-4">

                                        <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                            {{ product.quantity }}
                                        </span>

                                    </td>

                                    <td class="px-5 py-4 text-right">

                                        <a
                                            href="{{ path('app_product_show', {'id': product.id}) }}"
                                            class="font-medium text-blue-600 hover:text-blue-800"
                                        >
                                            Voir
                                        </a>

                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

            </div>

        {% else %}

            <div class="rounded-xl border border-green-200 bg-green-50 p-6">

                <p class="font-medium text-green-800">
                    Aucun produit en stock faible.
                </p>

                <p class="mt-1 text-sm text-green-700">
                    Tous les produits ont actuellement plus de 5 unités en stock.
                </p>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}

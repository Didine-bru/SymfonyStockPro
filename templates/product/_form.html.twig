{{ form_start(form, {
    'attr': {
        'class': 'space-y-6'
    }
}) }}

<div>
    {{ form_label(form.name, 'Nom du produit', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.name, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200',
            'placeholder': 'Ex : Clavier USB'
        }
    }) }}

    {{ form_errors(form.name) }}
</div>

<div>
    {{ form_label(form.description, 'Description', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.description, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200',
            'placeholder': 'Description du produit'
        }
    }) }}

    {{ form_errors(form.description) }}
</div>

<div>
    {{ form_label(form.price, 'Prix', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.price, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200',
            'placeholder': 'Ex : 50000'
        }
    }) }}

    {{ form_errors(form.price) }}
</div>

<div>
    {{ form_label(form.quantity, 'Quantité', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.quantity, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200',
            'placeholder': 'Ex : 10'
        }
    }) }}

    {{ form_errors(form.quantity) }}
</div>
<div>
    {{ form_label(form.stockInitial, 'Stock initial', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.stockInitial, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200',
            'placeholder': 'Ex : 10',
            'min': '0'
        }
    }) }}

    {{ form_errors(form.stockInitial) }}
</div>
<div>
    {{ form_label(form.category, 'Catégorie', {
        'label_attr': {
            'class': 'mb-2 block text-sm font-medium text-gray-700'
        }
    }) }}

    {{ form_widget(form.category, {
        'attr': {
            'class': 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 shadow-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200'
        }
    }) }}

    {{ form_errors(form.category) }}
</div>

<div class="flex items-center gap-3 pt-2">

    <button
    type="submit"
    class="inline-flex items-center gap-2 rounded-lg 
    bg-indigo-600 px-5 py-2.5 text-sm font-medium 
    text-white shadow-sm 
    hover:bg-indigo-700 
    focus:outline-none focus:ring-2 
    focus:ring-indigo-500 
    focus:ring-offset-2"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="h-4 w-4"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5.25 5.25A2.25 2.25 0 0 1 7.5 3h7.879a2.25 2.25 0 0 1 1.591.659l2.371 2.371A2.25 2.25 0 0 1 20 7.621V18.75A2.25 2.25 0 0 1 17.75 21h-11.5A2.25 2.25 0 0 1 4 18.75V6.25a1 1 0 0 1 1.25-1Z"
            />
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 3v5h8V3M8 21v-6h8v6"
            />
        </svg>

        {{ button_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}
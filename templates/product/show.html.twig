{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-5xl px-6 py-10">

    {# En-tête #}
    <div class="mb-8">
        <p class="text-sm font-medium text-blue-600">
            Produit #{{ product.id }}
        </p>

        <h1 class="mt-1 text-3xl font-bold text-gray-900">
            {{ product.name }}
        </h1>
    </div>

    {# Informations du produit #}
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="border-b border-gray-200 px-6 py-5">
            <h2 class="text-lg font-semibold text-gray-900">
                Informations du produit
            </h2>
        </div>

        <div class="grid gap-6 px-6 py-6 sm:grid-cols-2">

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Description
                </p>

                <p class="mt-1 text-gray-900">
                    {{ product.description ?: 'Aucune description' }}
                </p>
            </div>

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Catégorie
                </p>

                <p class="mt-1 text-gray-900">
                    {{ product.category ?: 'Non catégorisé' }}
                </p>
            </div>

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Prix
                </p>

                <p class="mt-1 text-xl font-semibold text-gray-900">
                    {{ product.price|number_format(2, ',', ' ') }} Ar
                </p>
            </div>

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Quantité en stock
                </p>

                <p class="mt-1 text-xl font-semibold text-gray-900">
                    {{ product.quantity }}
                </p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-500">
                    Stock initial
                </p>

                <p class="mt-1 text-xl font-semibold text-gray-900">
                    {{ product.stockInitial }}
                </p>
            </div>

        </div>

    </div>

    {# Informations techniques #}
    <div class="mt-6 rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="border-b border-gray-200 px-6 py-5">
            <h2 class="text-lg font-semibold text-gray-900">
                Informations techniques
            </h2>
        </div>

        <div class="grid gap-6 px-6 py-6 sm:grid-cols-2">

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Créé le
                </p>

                <p class="mt-1 text-gray-900">
                    {{ product.createdAt ? product.createdAt|date('d/m/Y à H:i') : '-' }}
                </p>
            </div>

            <div>
                <p class="text-sm font-medium text-gray-500">
                    Dernière modification
                </p>

                <p class="mt-1 text-gray-900">
                    {{ product.updatedAt ? product.updatedAt|date('d/m/Y à H:i') : '-' }}
                </p>
            </div>

        </div>

    </div>
    {# Mouvements de stock #}
    <div class="mt-6 rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">

            <div>
                <h2 class="text-lg font-semibold text-gray-900">
                    Mouvements de stock
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    Historique des entrées et sorties de ce produit.
                </p>
            </div>

            <a
                href="{{ path('app_stock_movement_new', {'product': product.id}) }}"
                class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700"
            >
                + Nouveau mouvement
            </a>

        </div>


        {% if product.stockMovements|length > 0 %}

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-gray-100">
                        <tr>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Type
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Quantité
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Motif
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Date
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Stock après
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                    {% for movement in movements %}

                        <tr class="border-t border-gray-200 hover:bg-gray-50">

                            <td class="px-5 py-4">

                                {% if movement.type == 'Entrée' %}

                                    <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-700">
                                        Entrée
                                    </span>

                                {% else %}

                                    <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-700">
                                        Sortie
                                    </span>

                                {% endif %}

                            </td>

                            <td class="px-5 py-4 font-medium text-gray-900">

                                {% if movement.type == 'Entrée' %}
                                    +{{ movement.quantity }}
                                {% else %}
                                    -{{ movement.quantity }}
                                {% endif %}

                            </td>

                            <td class="px-5 py-4 text-gray-600">
                                {{ movement.reason ?: 'Aucun motif' }}
                            </td>

                            <td class="px-5 py-4 text-gray-600">
                                {{ movement.createdAt|date('d/m/Y à H:i') }}
                            </td>
                            
                            <td class="px-5 py-4 font-semibold text-gray-900">
                                {{ stockAfterMovements[movement.id] }}
                            </td>

                            <td class="px-5 py-4">

                                <a
                                    href="{{ path('app_stock_movement_show', {'id': movement.id}) }}"
                                    class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
                                >
                                    Voir
                                </a>

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        {% else %}

            <div class="px-6 py-10 text-center">

                <p class="text-gray-500">
                    Aucun mouvement de stock pour ce produit.
                </p>

                <a
                    href="{{ path('app_stock_movement_new', {'product': product.id}) }}"
                    class="mt-4 inline-flex rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-700"
                >
                    + Ajouter un mouvement
                </a>

            </div>

        {% endif %}

    </div>
    {# Actions #}
    <div class="mt-8 flex flex-wrap items-center gap-3">

        <a
            href="{{ path('app_product_index') }}"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
        >
            ← Retour aux produits
        </a>

        <a
            href="{{ path('app_product_edit', {'id': product.id}) }}"
            class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
        >
            Modifier
        </a>

        {{ include('product/_delete_form.html.twig') }}

    </div>

</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Modifier {{ product.name }} - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-3xl px-6 py-10">

    <div class="mb-8">
        <p class="text-sm font-medium text-blue-600">
            StockPro
        </p>

        <h1 class="mt-1 text-3xl font-bold text-gray-900">
            Modifier le produit
        </h1>

        <p class="mt-2 text-gray-600">
            Modifiez les informations du produit
            <span class="font-medium text-gray-900">{{ product.name }}</span>.
        </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="border-b border-gray-200 px-6 py-5">
            <h2 class="text-lg font-semibold text-gray-900">
                Informations du produit
            </h2>
        </div>

        <div class="px-6 py-6">

            {{ include('product/_form.html.twig', {
                button_label: 'Enregistrer les modifications'
            }) }}

        </div>

    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">

        <a
            href="{{ path('app_product_index') }}"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
        >
            ← Retour aux produits
        </a>

        <a
            href="{{ path('app_product_show', {'id': product.id}) }}"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
        >
            Voir le produit
        </a>

        {{ include('product/_delete_form.html.twig') }}

    </div>

</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Connexion - StockPro{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 flex items-center justify-center px-4 py-12">

    <div class="w-full max-w-md">

        {# Logo / titre #}
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-slate-800">
                StockPro
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Connectez-vous à votre espace
            </p>
        </div>

        {# Formulaire #}
        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8">

            {% if error %}
                <div class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-6 rounded-lg bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-700">
                    Vous êtes connecté en tant que
                    <strong>{{ app.user.userIdentifier }}</strong>.
                    <a href="{{ logout_path() }}" class="font-semibold underline">
                        Se déconnecter
                    </a>
                </div>
            {% endif %}

            <form method="post" class="space-y-6">

                {# Email #}
                <div>
                    <label
                        for="username"
                        class="block text-sm font-medium text-slate-700 mb-2"
                    >
                        Adresse email
                    </label>

                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm
                               text-slate-900 outline-none transition
                               focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                        placeholder="exemple@email.com"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                {# Mot de passe #}
                <div>
                    <label
                        for="password"
                        class="block text-sm font-medium text-slate-700 mb-2"
                    >
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="w-full rounded-lg border border-slate-300 px-4 py-3 text-sm
                               text-slate-900 outline-none transition
                               focus:border-blue-500 focus:ring-2 focus:ring-blue-100"
                        placeholder="Votre mot de passe"
                        autocomplete="current-password"
                        required
                    >
                </div>

                {# CSRF #}
                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                {# Bouton #}
                <button
                    type="submit"
                    class="w-full rounded-lg bg-blue-600 px-4 py-3
                           text-sm font-semibold text-white
                           shadow-sm transition
                           hover:bg-blue-700
                           focus:outline-none focus:ring-2
                           focus:ring-blue-500 focus:ring-offset-2"
                >
                    Se connecter
                </button>

            </form>

        </div>

        <p class="text-center text-xs text-slate-400 mt-6">
            © {{ "now"|date("Y") }} StockPro
        </p>

    </div>

</div>
{% endblock %}


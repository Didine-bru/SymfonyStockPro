{% extends 'base.html.twig' %}

{% block title %}StockPro - Gestion de stock{% endblock %}

{% block body %}

<div class="min-h-screen bg-slate-50">

    <!-- Header -->
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">

            <a href="{{ path('app_home') }}"
               class="text-2xl font-bold text-slate-800">
                Stock<span class="text-blue-600">Pro</span>
            </a>

            <a href="{{ path('app_login') }}"
               class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
                Se connecter
            </a>

        </div>
    </header>


    <!-- Hero -->
    <main>

        <section class="mx-auto max-w-7xl px-6 py-20">

            <div class="grid items-center gap-12 lg:grid-cols-2">

                <div>

                    <div class="mb-6 inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700">
                        Gestion de stock simplifiée
                    </div>

                    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
                        Gérez votre stock
                        <span class="text-blue-600"> simplement.</span>
                    </h1>

                    <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
                        StockPro vous permet de suivre vos produits,
                        vos catégories et vos mouvements de stock
                        depuis une interface simple et intuitive.
                    </p>

                    <div class="mt-8">

                        <a href="{{ path('app_login') }}"
                           class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white hover:bg-blue-700">

                            Accéder à StockPro

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="2"
                                 stroke="currentColor"
                                 class="h-5 w-5">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>

                            </svg>

                        </a>

                    </div>

                </div>


                <!-- Illustration -->
                <div>

                    <div class="rounded-3xl bg-white p-8 shadow-xl ring-1 ring-slate-200">

                        <p class="text-sm font-medium text-slate-500">
                            Tableau de bord
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-800">
                            StockPro
                        </p>


                        <div class="mt-6 grid grid-cols-2 gap-4">

                            <div class="rounded-xl bg-slate-50 p-5">

                                <p class="text-sm text-slate-500">
                                    Produits
                                </p>

                                <p class="mt-2 text-3xl font-bold text-slate-800">
                                    —
                                </p>

                            </div>


                            <div class="rounded-xl bg-slate-50 p-5">

                                <p class="text-sm text-slate-500">
                                    Catégories
                                </p>

                                <p class="mt-2 text-3xl font-bold text-slate-800">
                                    —
                                </p>

                            </div>


                            <div class="col-span-2 rounded-xl bg-blue-50 p-5">

                                <p class="text-sm text-blue-600">
                                    Mouvements de stock
                                </p>

                                <p class="mt-2 text-3xl font-bold text-slate-800">
                                    —
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Fonctionnalités -->
        <section class="border-t border-slate-200 bg-white">

            <div class="mx-auto max-w-7xl px-6 py-20">

                <div class="mx-auto max-w-2xl text-center">

                    <p class="text-sm font-semibold uppercase tracking-wider text-blue-600">
                        Fonctionnalités
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
                        Tout ce qu'il faut pour gérer votre stock
                    </h2>

                    <p class="mt-4 text-lg text-slate-600">
                        Une gestion centralisée pour garder une vision claire
                        de votre activité.
                    </p>

                </div>


                <div class="mt-12 grid gap-6 md:grid-cols-3">

                    <!-- Produits -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md">

                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-6 w-6 text-blue-600">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25M21 7.5v9l-9 5.25M3 7.5v9l9 5.25m0-9v9"/>

                            </svg>

                        </div>

                        <h3 class="mt-5 text-lg font-semibold text-slate-900">
                            Gestion des produits
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-600">
                            Ajoutez, consultez, modifiez et supprimez
                            facilement vos produits.
                        </p>

                    </div>


                    <!-- Catégories -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md">

                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-6 w-6 text-emerald-600">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>

                            </svg>

                        </div>

                        <h3 class="mt-5 text-lg font-semibold text-slate-900">
                            Catégories
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-600">
                            Organisez vos produits avec une classification
                            claire et structurée.
                        </p>

                    </div>


                    <!-- Mouvements -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md">

                        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 fill="none"
                                 viewBox="0 0 24 24"
                                 stroke-width="1.8"
                                 stroke="currentColor"
                                 class="h-6 w-6 text-amber-600">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75h-1.5M7.5 3.75h9M7.5 3.75v3h9v-3M8.25 12h7.5m-7.5 3.75h4.5"/>

                            </svg>

                        </div>

                        <h3 class="mt-5 text-lg font-semibold text-slate-900">
                            Mouvements de stock
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-600">
                            Suivez les entrées et sorties de stock
                            pour garder le contrôle de vos inventaires.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-slate-50">

        <div class="mx-auto max-w-7xl px-6 py-8 text-center">

            <p class="text-sm text-slate-500">
                © {{ "now"|date("Y") }} StockPro.
                Application de gestion de stock.
            </p>

        </div>

    </footer>

</div>

{% endblock %}
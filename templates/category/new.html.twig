{% extends 'base.html.twig' %}

{% block title %}Nouvelle catégorie - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-3xl px-6 py-10">

    {# En-tête #}
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
            Nouvelle catégorie
        </h1>

        <p class="mt-2 text-gray-600">
            Ajoutez une nouvelle catégorie pour organiser vos produits.
        </p>
    </div>


    {# Formulaire #}
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">

        {{ include('category/_form.html.twig', {
            'button_label': 'Créer la catégorie'
        }) }}

    </div>


    {# Retour #}
    <div class="mt-6">

        <a
            href="{{ path('app_category_index') }}"
            class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
        >
            ← Retour aux catégories
        </a>

    </div>

</div>

{% endblock %}
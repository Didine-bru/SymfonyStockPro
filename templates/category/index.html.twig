{% extends 'base.html.twig' %}

{% block title %}Catégories - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-7xl px-6 py-10">

    {# En-tête #}
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                Catégories
            </h1>

            <p class="mt-2 text-gray-600">
                Gérez les catégories de vos produits.
            </p>
        </div>

        <a
            href="{{ path('app_category_new') }}"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        >
            + Nouvelle catégorie
        </a>

    </div>


    {# Tableau #}
    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-gray-100">
                    <tr>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Catégorie
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Description
                        </th>

                        <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                {% for category in categories %}

                    <tr class="border-t border-gray-200 hover:bg-gray-50">

                        <td class="px-5 py-4 font-medium text-gray-900">
                            {{ category.name }}
                        </td>

                        <td class="px-5 py-4 text-gray-600">
                            {{ category.description ?: 'Aucune description' }}
                        </td>

                        <td class="px-5 py-4">

                            <div class="flex flex-wrap gap-2">

                                <a
                                    href="{{ path('app_category_show', {'id': category.id}) }}"
                                    class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
                                >
                                    Voir
                                </a>

                                <a
                                    href="{{ path('app_category_edit', {'id': category.id}) }}"
                                    class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                                >
                                    Modifier
                                </a>

                            </div>

                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="3" class="px-5 py-12 text-center">

                            <p class="text-gray-500">
                                Aucune catégorie enregistrée.
                            </p>

                            <a
                                href="{{ path('app_category_new') }}"
                                class="mt-4 inline-block text-sm font-medium text-blue-600 hover:text-blue-700"
                            >
                                Créer une première catégorie
                            </a>

                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}
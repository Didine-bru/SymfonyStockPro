{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - StockPro{% endblock %}

{% block body %}

<div class="mx-auto max-w-7xl px-6 py-10">

    {# En-tête de la catégorie #}
    <div class="mb-8">
        <div class="mb-3">
            <a
                href="{{ path('app_category_index') }}"
                class="text-sm font-medium text-blue-600 hover:text-blue-700"
            >
                ← Retour aux catégories
            </a>
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
            {{ category.name }}
        </h1>

        <p class="mt-2 text-gray-600">
            {{ category.description ?: 'Aucune description pour cette catégorie.' }}
        </p>
    </div>


    {# Produits de la catégorie #}
    <div class="mb-4">
        <h2 class="text-2xl font-bold text-gray-900">
            Produits de cette catégorie
        </h2>

        <p class="mt-1 text-sm text-gray-500">
            {{ category.products|length }}
            produit{% if category.products|length > 1 %}s{% endif %}
            dans cette catégorie.
        </p>
    </div>


    {% if category.products|length > 0 %}

        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-gray-100">
                        <tr>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Produit
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Prix
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Stock
                            </th>

                            <th class="px-5 py-4 text-left text-sm font-semibold text-gray-700">
                                Actions
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                    {% for product in category.products %}

                        <tr class="border-t border-gray-200 hover:bg-gray-50">

                            <td class="px-5 py-4">
                                <a
                                    href="{{ path('app_product_show', {'id': product.id}) }}"
                                    class="font-medium text-gray-900 hover:text-blue-600"
                                >
                                    {{ product.name }}
                                </a>
                            </td>

                            <td class="px-5 py-4 text-gray-600">
                                {{ product.price|number_format(2, ',', ' ') }} Ar
                            </td>

                            <td class="px-5 py-4">

                                {% if product.quantity == 0 %}

                                    <span class="inline-flex rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-700">
                                        Rupture
                                    </span>

                                {% elseif product.quantity <= 5 %}

                                    <span class="inline-flex rounded-full bg-orange-100 px-3 py-1 text-sm font-medium text-orange-700">
                                        {{ product.quantity }}
                                    </span>

                                {% else %}

                                    <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-700">
                                        {{ product.quantity }}
                                    </span>

                                {% endif %}

                            </td>

                            <td class="px-5 py-4">

                                <a
                                    href="{{ path('app_product_show', {'id': product.id}) }}"
                                    class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
                                >
                                    Voir
                                </a>

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    {% else %}

        <div class="rounded-xl border border-gray-200 bg-white p-10 text-center shadow-sm">

            <p class="text-gray-500">
                Aucun produit dans cette catégorie.
            </p>

            <a
                href="{{ path('app_product_new') }}"
                class="mt-4 inline-flex rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700"
            >
                + Ajouter un produit
            </a>

        </div>

    {% endif %}


    {# Actions de la catégorie #}
    <div class="mt-8 flex flex-wrap items-center gap-3">

        <a
            href="{{ path('app_category_index') }}"
            class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"
        >
            ← Retour aux catégories
        </a>

        <a
            href="{{ path('app_category_edit', {'id': category.id}) }}"
            class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700"
        >
            Modifier
        </a>

        {{ include('category/_delete_form.html.twig') }}

    </div>

</div>

{% endblock %}